# Database Configuration
# Use SQLite for local development:
DATABASE_URL=sqlite:///./interviewx.db
# Or PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/interviewx

# LLM Configuration
# Set to 'mock' to run the entire system offline without an API Key
# Set to 'real' to execute actual calls via OpenAI
LLM_MODE=mock
OPENAI_API_KEY=your-openai-api-key-here

# Security
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=4f63c87e83dfca103db81289de61d9a24bbfe384918e9102c91823ab9128abf1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180

# System Settings
CHROMA_PATH=./chroma_db
FRONTEND_URL=http://localhost:8000
UPLOAD_DIR=./uploads
KNOWLEDGE_BASE_DIR=./knowledge_base
